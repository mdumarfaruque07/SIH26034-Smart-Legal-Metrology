# Smart Legal Metrology Package Compliance System (SIH26034)
# Root Environment Template

# Google Gemini API Key for vision label extraction
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model for vision/multimodal label extraction
GEMINI_MODEL=gemini-3.6-flash

# CORS Allowed Origins for Local Development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Dedicated MySQL Relational Database Configuration
USE_MYSQL=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD="your_mysql_password_here"
MYSQL_DATABASE=legal_metrology
