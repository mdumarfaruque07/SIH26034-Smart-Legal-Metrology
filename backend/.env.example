# Smart Legal Metrology Package Compliance System (SIH26034)
# Backend Environment Configuration

# Google Gemini API Key for vision label extraction
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=KEY

# Recommended model for vision/multimodal label extraction
GEMINI_MODEL=gemini-3.6-flash

# CORS Allowed Origins for Local Development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# -------------------------------------------------------------
# Database Configuration (MySQL or Embedded SQLite)
# -------------------------------------------------------------
# Option A: MySQL Connection (Recommended if you use MySQL / XAMPP / WAMP)
# IMPORTANT: Always enclose password in double quotes "" if it contains special characters like #, $, @, etc.
# USE_MYSQL=true
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD="your#password#here"
# MYSQL_DATABASE=legal_metrology

# Option B: Database URL format (MySQL / PostgreSQL / Supabase)
# DATABASE_URL=mysql://root:password@localhost:3306/legal_metrology

# Note: If MySQL is not configured or not running, the system will
# automatically and safely use the embedded SQLite database (backend/app/data/legal_metrology.db).
